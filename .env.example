# PostgreSQL connection for the pipeline and web app
DATABASE_URL=postgresql:///boardtenure_dev
# SEC EDGAR requires a declared User-Agent with a reachable contact address
SEC_USER_AGENT=Boardtape you@yourdomain.example
# Optional: enables AI-assisted extraction of 8-K / proxy text (quotes are always machine-verified)
ANTHROPIC_API_KEY=
# Admin UI basic auth (web)
ADMIN_USER=admin
ADMIN_PASSWORD=
# Comma-separated API keys allowed higher rate limits (web)
API_KEYS=
